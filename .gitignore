# =====================================================================
# Django
# =====================================================================
# Local SQLite — production uses Postgres via DATABASE_URL.
db.sqlite3
db.sqlite3-journal
*.sqlite3

# Collected static files (generated by collectstatic, regenerated on deploy).
/staticfiles/

# Local media uploads (we have none in v1, but reserve the path).
/media/

# Django log output if any (none configured by default).
*.log

# Migration files MUST be checked in — do not add them here.

# =====================================================================
# Secrets / environment
# =====================================================================
.env
.env.*
!.env.example
# Never commit a populated dotenv. SECRET_KEY and PEPPER are env-only
# and the README explains how to regenerate them.

# =====================================================================
# Editor / IDE
# =====================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

